# local bootstrap configuration. copy to .env before starting the stack.
# vanille service ports. keep local urls and cors origins aligned.
FRONTMATTER_PORT=9101
FRONTPAGE_PORT=9100
BACKEND_PORT=9000
DB_PORT=9003
NEO4J_HTTP_PORT=9004
NEO4J_BOLT_PORT=9005

CORS_ORIGINS=http://localhost:9101,http://localhost:9100
MEMORY_SERVICE_URL=http://localhost:9003

# local connection settings. compose replaces the uri with its internal hostname.
NEO4J_URI=bolt://localhost:9005
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=vanille-local-dev
